# Margin Reader needs no runtime environment variables. Users add their own
# Gemini key inside the app, where macOS Keychain-backed safeStorage protects it.

# Optional release configuration (normally injected by GitHub Actions).
GITHUB_REPOSITORY=lichen0114/margin-reader
APPLE_CODESIGN_IDENTITY=
APPLE_API_KEY=
APPLE_API_KEY_ID=
APPLE_API_ISSUER=
