{
  "name": "margin-reader",
  "productName": "Margin Reader",
  "version": "0.2.0",
  "description": "A private, local-first EPUB reader for macOS",
  "main": ".vite/build/main.js",
  "private": true,
  "engines": {
    "node": ">=20.9.0"
  },
  "scripts": {
    "dev": "electron-forge start",
    "start": "pnpm dev",
    "rebuild:electron": "electron-rebuild --force --which-module better-sqlite3 --version 43.1.1 --arch arm64",
    "rebuild:makers": "node-gyp rebuild --directory node_modules/macos-alias && node-gyp rebuild --directory node_modules/fs-xattr",
    "package": "pnpm rebuild:electron && electron-forge package --arch=arm64",
    "make": "pnpm rebuild:makers && pnpm rebuild:electron && electron-forge make --arch=arm64",
    "publish": "pnpm rebuild:makers && pnpm rebuild:electron && electron-forge publish --arch=arm64",
    "lint": "eslint . --max-warnings=0",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "pnpm package && playwright test",
    "db:migrate": "tsx scripts/migrate.ts",
    "db:seed": "tsx scripts/seed.ts"
  },
  "dependencies": {
    "better-sqlite3": "12.11.1",
    "clsx": "2.1.1",
    "drizzle-orm": "0.45.2",
    "epubjs": "0.3.93",
    "fast-xml-parser": "5.3.5",
    "jszip": "3.10.1",
    "linkedom": "0.18.12",
    "lucide-react": "0.468.0",
    "react": "19.2.7",
    "react-dom": "19.2.7",
    "sanitize-html": "2.17.0",
    "tailwind-merge": "3.4.0",
    "zod": "4.3.5"
  },
  "devDependencies": {
    "@electron-forge/cli": "7.11.2",
    "@electron-forge/maker-dmg": "7.11.2",
    "@electron-forge/maker-zip": "7.11.2",
    "@electron-forge/plugin-auto-unpack-natives": "7.11.2",
    "@electron-forge/plugin-fuses": "7.11.2",
    "@electron-forge/plugin-vite": "7.11.2",
    "@electron-forge/publisher-github": "7.11.2",
    "@electron/fuses": "1.8.0",
    "@electron/rebuild": "3.7.2",
    "@playwright/test": "1.61.1",
    "@tailwindcss/postcss": "4.3.2",
    "@testing-library/jest-dom": "6.9.1",
    "@testing-library/react": "16.3.2",
    "@types/better-sqlite3": "7.6.13",
    "@types/node": "24.10.4",
    "@types/react": "19.2.7",
    "@types/react-dom": "19.2.3",
    "@types/sanitize-html": "2.16.0",
    "@vitejs/plugin-react": "5.1.2",
    "electron": "43.1.1",
    "drizzle-kit": "0.31.8",
    "esbuild": "0.27.7",
    "eslint": "9.39.2",
    "globals": "16.5.0",
    "jsdom": "27.4.0",
    "tailwindcss": "4.3.2",
    "tsx": "4.21.0",
    "typescript": "5.9.3",
    "typescript-eslint": "8.50.0",
    "vite": "7.3.0",
    "vitest": "4.1.10"
  },
  "packageManager": "pnpm@10.21.0",
  "pnpm": {
    "onlyBuiltDependencies": [
      "better-sqlite3",
      "electron",
      "esbuild"
    ]
  }
}
